{
  "name": "workos-agent",
  "private": true,
  "version": "0.0.25",
  "description": "Desktop agent that orchestrates workOS workflows on the local machine.",
  "author": {
    "name": "Jong-hun Kwon",
    "email": "kwon.jonghun@nbt.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:mcp": "node scripts/build-mcp-server.mjs",
    "dev": "npm run build:mcp && vite",
    "build": "npm run build:mcp && tsc -b && vite build && electron-builder",
    "build:mac": "npm run build:mcp && set -a && . ./.env && set +a && tsc -b && vite build && electron-builder --mac",
    "release:mac": "npm run build:mcp && set -a && . ./.env && set +a && tsc -b && vite build && electron-builder --mac --publish always",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.workos.agent",
    "productName": "workOS-Agent",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kwonjonghun-nbt",
        "repo": "workOS-Agent",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.100.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
